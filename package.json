{
  "name": "headroom-finance",
  "version": "0.2.3",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "server": "tsx server/index.ts",
    "pair-device": "tsx server/pair-device.ts",
    "export:android": "node node_modules/expo/bin/cli export --platform android",
    "prepare:dependencies": "node scripts/prepare-dependencies.cjs",
    "postinstall": "node scripts/prepare-dependencies.cjs",
    "pretest": "node scripts/prepare-dependencies.cjs",
    "prestart": "node scripts/prepare-dependencies.cjs",
    "preexport:android": "node scripts/prepare-dependencies.cjs",
    "security:check": "node scripts/prepare-dependencies.cjs --check",
    "audit:verified": "node scripts/check-audit.cjs",
    "format": "prettier --write \"App.tsx\" \"src/**/*.{ts,tsx}\" \"server/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"App.tsx\" \"src/**/*.{ts,tsx}\" \"server/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint App.tsx src server tests"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "decimal.js": "^10.5.0",
    "expo": "~57.0.29",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.0",
    "expo-local-authentication": "~57.0.3",
    "expo-screen-capture": "~57.0.4",
    "expo-secure-store": "~57.0.0",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.0",
    "react": "19.2.3",
    "react-native": "^0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.0.4"
  },
  "type": "module",
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    },
    "glob": "^14.0.6",
    "minimatch": "^11.0.1",
    "node-forge": "^1.4.3",
    "expo": "$expo"
  }
}
