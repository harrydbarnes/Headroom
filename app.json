{
  "expo": {
    "name": "Headroom",
    "slug": "headroom",
    "version": "0.2.3",
    "scheme": "headroom",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "uk.co.habylab.headroom",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/headroom-icon.png",
        "backgroundColor": "#174E3B"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      "expo-sharing"
    ],
    "extra": {
      "purpose": "Personal finance and house-move planning"
    },
    "icon": "./assets/headroom-icon.png"
  }
}
