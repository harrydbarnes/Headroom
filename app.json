{
  "expo": {
    "name": "Headroom",
    "slug": "headroom",
    "version": "0.2.3",
    "scheme": "headroom",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "uk.co.habylab.headroom",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/headroom-launcher.png",
        "backgroundColor": "#174E3B"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      "expo-sharing",
      ["expo-splash-screen", {
        "image": "./assets/headroom-splash.png",
        "imageWidth": 128,
        "resizeMode": "contain",
        "backgroundColor": "#F8FAF5"
      }]
    ],
    "extra": {
      "purpose": "Personal finance and house-move planning"
    },
    "icon": "./assets/headroom-launcher.png"
  }
}
